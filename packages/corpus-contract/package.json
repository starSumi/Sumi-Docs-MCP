{
  "name": "@sumi-os/corpus-contract",
  "version": "0.1.0",
  "description": "Versioned Sumi documentation corpus schemas and conformance helpers.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test tests/**/*.test.mjs",
    "verify": "pnpm run typecheck && pnpm test"
  },
  "engines": {
    "node": ">=25.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
