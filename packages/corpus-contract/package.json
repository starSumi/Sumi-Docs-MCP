{
  "name": "@sumi-labs/corpus-contract",
  "version": "0.1.0",
  "description": "Versioned Sumi documentation corpus schemas and conformance helpers.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starSumi/Sumi-Docs-MCP.git",
    "directory": "packages/corpus-contract"
  },
  "homepage": "https://github.com/starSumi/Sumi-Docs-MCP/tree/main/packages/corpus-contract#readme",
  "bugs": {
    "url": "https://github.com/starSumi/Sumi-Docs-MCP/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "node --run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --run build && node --test tests/**/*.test.mjs",
    "verify": "node --run typecheck && node --run test"
  },
  "engines": {
    "node": ">=25.5.0"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
