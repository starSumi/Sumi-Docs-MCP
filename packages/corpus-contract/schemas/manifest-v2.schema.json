{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-v2.schema.json",
  "title": "Sumi Docs immutable corpus manifest v2",
  "$comment": "The runtime parser additionally verifies canonical BCP 47 tags, cross-field uniqueness, byte totals, and the computed revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "defaultLocale",
    "locales",
    "documents",
    "provenance"
  ],
  "properties": {
    "version": { "const": 2 },
    "revision": { "$ref": "#/$defs/revision" },
    "defaultLocale": { "$ref": "#/$defs/locale" },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/locale" }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/document" }
    },
    "openapi": { "$ref": "#/$defs/openapi" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
      "x-sumi-canonical-bcp47": true
    },
    "documentPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_/-]+\\.mdx?$",
      "allOf": [{ "not": { "pattern": "^/" } }, { "not": { "pattern": "//" } }]
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?:.*\\/)?$",
      "allOf": [
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "[\\\\?#%\\u0000-\\u0020\\u007f]" } },
        { "not": { "pattern": "/(?:\\.|\\.\\.)/" } }
      ]
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "sectionOrder", "order"],
      "properties": {
        "sectionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "sectionOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "locale",
        "path",
        "route",
        "mediaType",
        "bytes",
        "sha256",
        "nav"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "locale": { "$ref": "#/$defs/locale" },
        "path": { "$ref": "#/$defs/documentPath" },
        "route": { "$ref": "#/$defs/route" },
        "mediaType": { "enum": ["text/markdown", "text/mdx"] },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "sha256": { "$ref": "#/$defs/digest" },
        "nav": { "$ref": "#/$defs/navigation" }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_/-]+\\.json$",
          "allOf": [
            { "not": { "pattern": "^/" } },
            { "not": { "pattern": "//" } }
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^https://[^?#]+$"
            }
          ]
        },
        "commit": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          ]
        },
        "dirty": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["repository"],
            "properties": { "repository": { "type": "null" } }
          },
          "then": { "properties": { "commit": { "type": "null" } } }
        }
      ]
    }
  }
}
