{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-v2.schema.json",
  "title": "Sumi Docs current corpus locator v2",
  "$comment": "The runtime parser additionally requires manifest to contain the digest directory derived from revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "manifest", "bytes", "sha256"],
  "properties": {
    "version": { "const": 2 },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "manifest": {
      "type": "string",
      "pattern": "^snapshots/[a-f0-9]{64}/manifest\\.json$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
