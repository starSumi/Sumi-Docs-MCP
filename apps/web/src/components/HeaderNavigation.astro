---
import { resolveHeaderNavigation } from "../header-navigation.ts";

const { lang } = Astro.locals.starlightRoute;
const navigation = resolveHeaderNavigation(
  lang,
  import.meta.env.BASE_URL,
  Astro.url.pathname,
);
---

<nav class="header-navigation" aria-label={navigation.label}>
  {
    navigation.items.map((item) => (
      <a
        href={item.href}
        aria-current={item.active ? "location" : undefined}
        data-header-navigation-item={item.id}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  @layer starlight.core {
    .header-navigation {
      display: none;
      align-items: center;
      gap: 0.125rem;
      padding-inline-start: 0.75rem;
      margin-inline-start: 0.75rem;
      border-inline-start: 1px solid var(--sl-color-gray-5);
      white-space: nowrap;
    }

    a {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      padding-inline: 0.5rem;
      border-radius: 4px;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      font-weight: 500;
      text-decoration: none;
    }

    a:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
    }

    a[aria-current="location"] {
      color: var(--sl-color-accent-high);
      background: var(--sl-color-accent-low);
      font-weight: 600;
    }

    a:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }

    @media (min-width: 72rem) {
      .header-navigation {
        display: flex;
      }
    }
  }
</style>
