# Required by a release build so canonical links and the sitemap use the deployed origin.
SITE_URL=https://docs.example.com
# Use / for an origin deployment or a root-relative mount such as /project/.
BASE_PATH=/
# Optional pair. When both are set, the build publishes discovery metadata and verifies readiness.
PUBLIC_MCP_URL=https://mcp.example.com/mcp
PUBLIC_MCP_READINESS_URL=https://mcp.example.com/readyz
