{
  "name": "@sumi-os/docs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && npm run verify:dist",
    "build:release": "npm run validate:release-env && npm run build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/**/*.test.mjs",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "lint:staged": "lint-staged --fail-on-changes",
    "commitlint": "commitlint",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "validate:release-env": "node scripts/validate-release-env.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "verify": "npm run format:check && npm test && npm run build",
    "verify:release": "npm run format:check && npm test && npm run build:release && npm run audit:prod",
    "verify:push": "npm run verify && npm run audit:prod",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro,json,md,mdx,css,yaml,yml}": "prettier --check"
  }
}
