{
  "name": "@sumi-os/docs-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Markdown, MDX, and OpenAPI documentation.",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starSumi/Sumi-Docs-MCP.git"
  },
  "homepage": "https://github.com/starSumi/Sumi-Docs-MCP#readme",
  "bugs": {
    "url": "https://github.com/starSumi/Sumi-Docs-MCP/issues"
  },
  "engines": {
    "node": ">=25.5.0"
  },
  "bin": {
    "sumi-docs-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts serve examples/basic/docs --openapi examples/basic/openapi.json --verbose",
    "dev:watch": "tsx watch src/index.ts serve examples/basic/docs --openapi examples/basic/openapi.json --verbose",
    "preview:docs": "node scripts/preview-docs.js",
    "start": "node dist/index.js serve examples/basic/docs --openapi examples/basic/openapi.json",
    "build": "node scripts/clean-dist.js && tsc && node scripts/post-build.js",
    "build:sea": "npm run build && node scripts/build-sea-bundle.js && node scripts/build-sea.js",
    "benchmark:cold-start": "node scripts/benchmark-cold-start.js",
    "example:smoke": "npm run build && node scripts/smoke-example.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:staged": "lint-staged --fail-on-changes",
    "commitlint": "commitlint",
    "test:git-hooks": "node scripts/git-hooks/test-gates.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:git-hooks",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "verify:push": "npm run verify && npm run audit:prod",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','.sea','artifacts','sea-prep.blob']) fs.rmSync(path,{recursive:true,force:true})\"",
    "prepare": "node .husky/install.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "ai-native",
    "llm",
    "markdown",
    "openapi",
    "stateless",
    "agent"
  ],
  "author": "Sumi OS",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "minimist": "^1.2.8",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-strip-html": "^1.0.2",
    "unified": "^11.0.4",
    "yaml": "^2.4.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.9.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{js,mjs,cjs,json,md,mdx,yaml,yml}": "prettier --check"
  },
  "files": [
    "dist",
    "docs/architecture.md",
    "docs/README.md",
    "docs/decisions/0001-astro-starlight-dual-surface.md",
    "docs/decisions/0002-polyrepo-and-package-manager.md",
    "docs/decisions/0003-localized-content-projection.md",
    "docs/decisions/0004-authoritative-repository-initialization.md",
    "docs/configuration.md",
    "docs/development.md",
    "docs/git-workflow.md",
    "docs/getting-started.md",
    "docs/releasing.md",
    "docs/remote-sources.md",
    "docs/troubleshooting.md",
    "docs/tool-reference.md",
    "examples",
    "scripts/preview-docs.js",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
